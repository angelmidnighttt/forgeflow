# Settings and secrets of a ForgeFlow server, read by compose.yml. On the server this file is
# /opt/forgeflow/.env (mode 600). scripts/bootstrap.sh creates it from this template with
# SITE_HOST and fresh secrets; fill in the email settings by hand. Never commit the real file.
#
# Values are taken literally, except that "$" starts a variable: put a value that contains "$"
# in single quotes.

# Public host name; Caddy gets its HTTPS certificate. Without a domain, use the server's IPv4
# address with dashes on sslip.io, which resolves to that address: 203-0-113-10.sslip.io
SITE_HOST=

# Docker images CI pushes (<prefix>-api and <prefix>-web, tagged with the commit SHA).
FORGEFLOW_IMAGES=ghcr.io/angelmidnighttt/forgeflow

# Owner of the database (migrations), the api's role, and the key that signs access tokens:
# `openssl rand -hex 32` each. Hex only, since the passwords go into connection URLs.
# POSTGRES_PASSWORD only takes effect when the database volume is created.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=

# Encrypts integration secrets: "<version>:<base64 of 32 random bytes>" (openssl rand -base64 32),
# comma-separated, the highest version current. Losing it loses every stored secret: back it up
# apart from the database dumps. Rotating it: README.md.
SECRET_ENCRYPTION_KEYS=

LOG_LEVEL=info

# Outgoing email: verification, password reset, invitations. Without a domain of your own, a
# Gmail account kept for this server works, with an app password (needs 2-step verification);
# MAIL_FROM must then be that address, and "@" in the user name is written %40:
#   SMTP_URL=smtps://<account>%40gmail.com:<app-password>@smtp.gmail.com:465
#   MAIL_FROM="ForgeFlow <<account>@gmail.com>"
SMTP_URL=
MAIL_FROM=

# The GitHub App that reports deployments (README.md, "GitHub App"). All six, or none (off).
# GITHUB_APP_PRIVATE_KEY: the downloaded .pem as base64 on one line (base64 -w0 key.pem), or
# the PEM with \n for its line breaks, in single quotes.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# "Sign in with GitHub": an OAuth app (https://github.com/settings/developers) whose callback URL
# is https://<SITE_HOST>/api/v1/auth/github/callback. Leave both empty to turn it off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
