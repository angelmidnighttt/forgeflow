# Local development settings. `npm run dev` copies this file to .env if .env does not exist.
# Never commit .env. Production values come from the deployment environment, not from files in the repo.

NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=dev

# PostgreSQL started by `npm run db:up` (infra/compose/docker-compose.yml)
DATABASE_URL=postgres://forgeflow:forgeflow@localhost:5432/forgeflow

# api
API_PORT=4000

# web: where the Next.js server proxies /api/* during local development
API_INTERNAL_URL=http://localhost:4000
