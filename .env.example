# Local development settings. `npm run dev` copies this file to .env if .env does not exist.
# Never commit .env. Production values come from the deployment environment, not from files in the repo.

NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=dev

# PostgreSQL started by `npm run db:up` (infra/compose/docker-compose.yml), with two roles
# (docs/adr/ADR-0002):
# - the api connects as forgeflow_app, which row-level security applies to (never the owner:
#   the api refuses to start as a role that bypasses RLS);
DATABASE_URL=postgres://forgeflow_app:forgeflow_app@localhost:5432/forgeflow
# - migrate / reset / seed connect as the owner of the tables.
MIGRATION_DATABASE_URL=postgres://forgeflow:forgeflow@localhost:5432/forgeflow

# Integration tests use their own database, recreated on every run. Defaults to the two URLs
# above with "_test" appended to the database name; the name must end with "_test".
# TEST_DATABASE_URL=postgres://forgeflow_app:forgeflow_app@localhost:5432/forgeflow_test
# TEST_MIGRATION_DATABASE_URL=postgres://forgeflow:forgeflow@localhost:5432/forgeflow_test

# api
API_PORT=4000
# Browser origin of the web app. State-changing requests from any other origin are rejected (CSRF).
APP_ORIGIN=http://localhost:3000
# Signs access tokens (HS256). This value is for local development only; the api refuses to start
# with it when NODE_ENV=production.
JWT_SECRET=dev-only-local-jwt-secret-change-me-0123456789
# Secure flag + __Secure- prefix on the refresh cookie. Defaults to true only when NODE_ENV=production.
# COOKIE_SECURE=false
# Reverse proxies allowed to set X-Forwarded-For (Express "trust proxy"), so rate limits and the
# sessions list see the client's IP. Locally the web dev server proxies /api from loopback.
# In production: the hop count ("1") or the proxy's addresses. Unset trusts no proxy.
TRUST_PROXY=loopback
# Outgoing email. Locally this is Mailpit from `npm run db:up`; read the mail at http://localhost:8025.
# Use smtps://user:password@host:465 (or smtp://…:587 with STARTTLS) for a real provider.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="ForgeFlow <no-reply@forgeflow.localhost>"

# "Sign in with GitHub": create an OAuth app at https://github.com/settings/developers with the
# callback URL http://localhost:3000/api/v1/auth/github/callback, then set both values.
# Leave them unset to turn GitHub sign-in off.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Integration tests read the mail the api sent through Mailpit's HTTP API.
# MAILPIT_URL=http://localhost:8025

# web: where the Next.js server proxies /api/* during local development
API_INTERNAL_URL=http://localhost:4000
