{
  "name": "@forgeflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ForgeFlow HTTP API (NestJS modular monolith)",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "secrets:rewrap": "node dist/scripts/rewrap-secrets.js",
    "dev:worker": "node --watch --enable-source-maps dist/worker.js",
    "worker": "node --enable-source-maps dist/worker.js"
  },
  "dependencies": {
    "@forgeflow/config": "*",
    "@forgeflow/contracts": "*",
    "@forgeflow/database": "*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.18",
    "nestjs-pino": "^5.3.2",
    "nodemailer": "^10.6.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.1.4"
  }
}
