{
  "name": "forgeflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ForgeFlow: deployment, incident and remediation control plane",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && npm run db:up && npm run db:app-role && tsc -b && npm run db:migrate && concurrently -k -n build,api,worker,web -c gray,cyan,yellow,magenta \"tsc -b -w --preserveWatchOutput\" \"npm run dev -w @forgeflow/api\" \"npm run dev:worker -w @forgeflow/api\" \"npm run dev -w @forgeflow/web\"",
    "build": "tsc -b && npm run build -w @forgeflow/web",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && npm run typecheck -w @forgeflow/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -b && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:unit": "tsc -b && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects unit",
    "db:up": "docker compose -f infra/compose/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/compose/docker-compose.yml down",
    "db:app-role": "docker compose -f infra/compose/docker-compose.yml exec -T postgres psql -U forgeflow -d postgres -v ON_ERROR_STOP=1 -q < infra/compose/postgres/init/01-app-role.sql",
    "db:generate": "npm run generate -w @forgeflow/database",
    "db:migrate": "npm run migrate -w @forgeflow/database",
    "db:reset": "npm run reset -w @forgeflow/database",
    "db:seed": "npm run seed -w @forgeflow/database",
    "secrets:rewrap": "npm run secrets:rewrap -w @forgeflow/api",
    "github:app": "node scripts/github-app-setup.mjs",
    "github:replay": "node scripts/github-webhook-replay.mjs",
    "clean": "rimraf --glob \"apps/*/dist\" \"packages/*/dist\" \"apps/web/.next\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/node": "^22.20.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
